          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "SLO error budget remaining (retained window)",
      "type": "timeseries",
      "description": "Sloth period budget over the samples Prometheus still retains (two days locally), not the full 30 days. The ITOC Overview shows the durable 30-day purchase success and latency budgets from PostgreSQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * slo:period_error_budget_remaining:ratio",
          "legendFormat": "{{sloth_slo}} · {{environment}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
