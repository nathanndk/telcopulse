      "type": "timeseries",
      "description": "Measured telemetry. Gaps indicate unavailable measurements; idle ratios may be undefined. Process metrics describe the service process, not its host.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by(service)(rate(http_requests_total{status=~\"5..\"}[5m])) or on(service) (0 * sum by(service)(rate(http_requests_total[5m])))) / sum by(service)(rate(http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
