    {
      "id": 13,
      "title": "Synthetic purchase SLO · fast burn",
      "type": "timeseries",
      "description": "99.9% objective. Both 5m and 1h failure-budget burn must exceed 14.4×, with at least five terminal outcomes in 5m, for the fast alert branch. Counter-derived estimates can differ from the durable 30-day SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate5m{sloth_slo=\"purchase-success\"} / 0.001",
          "legendFormat": "{{environment}} · 5m"
        },
        {
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate1h{sloth_slo=\"purchase-success\"} / 0.001",
          "legendFormat": "{{environment}} · 1h"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Synthetic purchase SLO · sustained burn",
      "type": "timeseries",
      "description": "99.9% objective. Both 30m and 6h failure-budget burn must exceed 6×, with at least thirty terminal outcomes in 30m, for the sustained alert branch. Counter-derived estimates can differ from the durable 30-day SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate30m{sloth_slo=\"purchase-success\"} / 0.001",
          "legendFormat": "{{environment}} · 30m"
        },
        {
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate6h{sloth_slo=\"purchase-success\"} / 0.001",
          "legendFormat": "{{environment}} · 6h"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
