{
  "uid": "telcopulse-operations",
  "title": "TelcoPulse · Operations",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "telcopulse"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Business success rate",
      "type": "timeseries",
      "description": "Measured telemetry. Gaps indicate unavailable measurements; idle ratios may be undefined. Process metrics describe the service process, not its host.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * telcopulse:business_success_ratio:rate5m",
          "legendFormat": "{{environment}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Transactions / minute",
      "type": "timeseries",
      "description": "Measured telemetry. Gaps indicate unavailable measurements; idle ratios may be undefined. Process metrics describe the service process, not its host.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(environment)(rate(transaction_total[5m])) * 60",
          "legendFormat": "{{environment}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
