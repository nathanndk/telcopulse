{
  "uid": "telcopulse-infrastructure",
  "title": "TelcoPulse infrastructure",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "telcopulse"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Probe success",
      "type": "timeseries",
      "description": "Blackbox probes from inside the stack: 1 is up, 0 is failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "{{probe_name}}{{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Probe duration",
      "type": "timeseries",
      "description": "End-to-end probe time per target.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "description": "Sessions by state against max_connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count)",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "PostgreSQL transactions / second",
      "type": "timeseries",
      "description": "Commits and rollbacks across databases.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "legendFormat": "commit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "rollback"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Redis memory",
      "type": "timeseries",
      "description": "Used memory against maxmemory (noeviction: writes fail when full).",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "redis_memory_max_bytes",
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Kafka consumer group lag (broker view)",
      "type": "timeseries",
      "description": "kafka-exporter lag per group and topic; complements the service-side kafka_consumer_lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} · {{topic}}"
        },
        {
          "refId": "B",
          "expr": "sum(kafka_brokers)",
          "legendFormat": "brokers"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Host CPU",
      "type": "timeseries",
      "description": "Share of host CPU time not idle (WSL2 VM on this workstation).",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "busy"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Host memory available",
      "type": "timeseries",
      "description": "MemAvailable / MemTotal.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "available"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Root filesystem free",
      "type": "timeseries",
      "description": "Free share of / with the 24-hour linear prediction used by HostDiskWillFillIn24h.",
      "datasource": {
        "type": "prometheus",
        "uid": "telcopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "legendFormat": "free"
        },
        {
          "refId": "B",
          "expr": "predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h], 86400) / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "legendFormat": "predicted in 24h"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Log lines by level",
      "type": "timeseries",
      "description": "Loki ingestion from Alloy: structured log lines per service and level.",
      "datasource": {
        "type": "loki",
        "uid": "telcopulse-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, level) (count_over_time({project=\"telcopulse\"} [1m]))",
          "legendFormat": "{{service}} · {{level}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Error logs",
      "type": "logs",
      "description": "ERROR-level lines; expand a line and use the trace_id link to open the trace in Jaeger.",
      "datasource": {
        "type": "loki",
        "uid": "telcopulse-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"telcopulse\", level=\"ERROR\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
