// Ships stdout/stderr of the telcopulse Compose project to Loki. Go services
// log JSON through slog: level becomes a label, trace_id structured metadata.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=telcopulse"]
  }
}

discovery.relabel "containers" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.structured.receiver]
}

loki.process "structured" {
  stage.json {
    expressions = {level = "level", trace_id = "trace_id"}
  }
  stage.labels {
    values = {level = ""}
  }
  stage.structured_metadata {
    values = {trace_id = ""}
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
